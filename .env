DB_HOST=localhost
DB_USER=root
DB_PASSWORD=12345678
DB_NAME=mydb
DB_PORT=3306

PORT=8080

# Set to "development" for development features like verbose error stacks
NODE_ENV=development

# Set to "true" to seed the database on startup in development mode (via app.js)
# Make sure NODE_ENV is also "development"
SEED_DB=true

